# Copy this file to .env and fill in your own values.

# MongoDB connection string (MongoDB Atlas or local instance)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# JWT settings — generate a long random string for JWT_SECRET
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Test database connection (used by `pnpm test`)
MONGO_TEST_URI=
